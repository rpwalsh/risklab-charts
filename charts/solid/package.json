{
  "name": "@risklab/charts-solid",
  "version": "1.0.0",
  "description": "Solid adapter package for @risklab/charts.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "rimraf dist && node ../../tools/ensure-root-build.mjs && node ../../tools/sync-chart-adapter.mjs solid && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "typecheck": "node ../../tools/ensure-root-build.mjs && node ../../tools/sync-chart-adapter.mjs solid && tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "charts",
    "solid",
    "solid-js",
    "dataviz",
    "risklab"
  ],
  "author": "RiskLab Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpwalsh/risklab-charts",
    "directory": "charts/solid"
  },
  "homepage": "https://walshtechgroup.com/risklab/",
  "bugs": {
    "url": "https://github.com/rpwalsh/risklab-charts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@risklab/charts": "1.0.0",
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "@risklab/charts": "file:../..",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module"
}
