{
    "name":  "@risklab/charts-solid",
    "version":  "1.0.0",
    "description":  "Solid adapter package for @risklab/charts.",
    "main":  "dist/cjs/index.js",
    "module":  "dist/esm/index.js",
    "types":  "dist/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./dist/types/index.d.ts",
                              "import":  "./dist/esm/index.js",
                              "require":  "./dist/cjs/index.js"
                          }
                },
    "sideEffects":  false,
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE",
                  "NOTICE",
                  "LICENSE.txt"
              ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json \u0026\u0026 tsc -p tsconfig.cjs.json",
                    "clean":  "rimraf dist",
                    "typecheck":  "tsc --noEmit",
                    "prepublishOnly":  "npm run clean \u0026\u0026 npm run build"
                },
    "keywords":  [
                     "charts",
                     "solid",
                     "solid-js",
                     "dataviz",
                     "risklab"
                 ],
    "author":  "RiskLab Contributors",
    "license":  "Apache-2.0",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/rpwalsh/risklab-charts",
                       "directory":  "charts/solid"
                   },
    "homepage":  "https://walshtechgroup.com/risklab/",
    "bugs":  {
                 "url":  "https://github.com/rpwalsh/risklab-charts/issues"
             },
    "publishConfig":  {
                          "access":  "public"
                      },
    "peerDependencies":  {
                             "@risklab/charts":  "1.0.0",
                             "solid-js":  "\u003e=1.8.0"
                         },
    "devDependencies":  {
                            "@risklab/charts":  "file:../..",
                            "rimraf":  "^6.0.0",
                            "typescript":  "^5.7.0"
                        },
    "engines":  {
                    "node":  "\u003e=20.0.0"
                }
}
