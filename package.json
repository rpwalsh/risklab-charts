{
    "name": "@risklab/charts",
    "version": "1.0.0",
    "private": false,
    "description": "@risklab/charts - Typed analytical charting engine with basic and advanced chart families for serious analytical software.",
    "workspaces": [
        "charts/react",
        "charts/vanilla",
        "charts/vue",
        "charts/svelte",
        "charts/angular",
        "charts/lit",
        "charts/solid"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./react": {
            "types": "./dist/types/adapters/react/index.d.ts",
            "import": "./dist/esm/adapters/react/index.js",
            "require": "./dist/cjs/adapters/react/index.js"
        },
        "./mui": {
            "types": "./dist/types/adapters/mui/index.d.ts",
            "import": "./dist/esm/adapters/mui/index.js",
            "require": "./dist/cjs/adapters/mui/index.js"
        },
        "./stylex": {
            "types": "./dist/types/adapters/stylex/index.d.ts",
            "import": "./dist/esm/adapters/stylex/index.js",
            "require": "./dist/cjs/adapters/stylex/index.js"
        },
        "./basic": {
            "types": "./dist/types/charts/basic/index.d.ts",
            "import": "./dist/esm/charts/basic/index.js",
            "require": "./dist/cjs/charts/basic/index.js"
        },
        "./palettes": {
            "types": "./dist/types/themes/palettes.d.ts",
            "import": "./dist/esm/themes/palettes.js",
            "require": "./dist/cjs/themes/palettes.js"
        },
        "./css-vars": {
            "types": "./dist/types/themes/cssVars.d.ts",
            "import": "./dist/esm/themes/cssVars.js",
            "require": "./dist/cjs/themes/cssVars.js"
        },
        "./advanced": {
            "types": "./dist/types/charts/advanced/index.d.ts",
            "import": "./dist/esm/charts/advanced/index.js",
            "require": "./dist/cjs/charts/advanced/index.js"
        },
        "./3d": {
            "types": "./dist/types/experimental/index.d.ts",
            "import": "./dist/esm/experimental/index.js",
            "require": "./dist/cjs/experimental/index.js"
        },
        "./experimental": {
            "types": "./dist/types/experimental/index.d.ts",
            "import": "./dist/esm/experimental/index.js",
            "require": "./dist/cjs/experimental/index.js"
        },
        "./themes/default": {
            "types": "./dist/types/themes/defaultTheme.d.ts",
