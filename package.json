                  "LICENSE.txt"
              ],
    "funding":  {
                    "type":  "github",
                    "url":  "https://github.com/sponsors/risklab"
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json \u0026\u0026 tsc -p tsconfig.cjs.json",
                    "dev":  "tsc -p tsconfig.build.json --watch",
                    "lint":  "eslint src charts tests --ext .ts,.tsx",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:coverage":  "vitest run --coverage",
                    "clean":  "rimraf dist",
                    "prepublishOnly":  "npm run clean \u0026\u0026 npm run build",
                    "typecheck":  "tsc --noEmit",
                    "size":  "node -e \"const fs=require(\u0027fs\u0027),p=f=\u003efs.statSync(f).size;console.log(\u0027ESM entry:\u0027,Math.round(p(\u0027dist/esm/index.js\u0027)/1024)+\u0027kB\u0027);console.log(\u0027CJS entry:\u0027,Math.round(p(\u0027dist/cjs/index.js\u0027)/1024)+\u0027kB\u0027)\"",
                    "validate":  "npm run clean \u0026\u0026 npm run build \u0026\u0026 npm run typecheck \u0026\u0026 npm run test \u0026\u0026 npm run size",
                    "build:charts-react":  "npm run build --workspace=charts/react",
                    "build:charts-vanilla":  "npm run build --workspace=charts/vanilla",
                    "build:charts-vue":  "npm run build --workspace=charts/vue",
                    "build:charts-svelte":  "npm run build --workspace=charts/svelte",
                    "build:charts-angular":  "npm run build --workspace=charts/angular",
                    "build:charts-lit":  "npm run build --workspace=charts/lit",
                    "build:charts-solid":  "npm run build --workspace=charts/solid",
                    "build:all":  "npm run build \u0026\u0026 npm run build --workspace=charts/react \u0026\u0026 npm run build --workspace=charts/vanilla \u0026\u0026 npm run build --workspace=charts/vue \u0026\u0026 npm run build --workspace=charts/svelte \u0026\u0026 npm run build --workspace=charts/angular \u0026\u0026 npm run build --workspace=charts/lit \u0026\u0026 npm run build --workspace=charts/solid",
                    "pack:all":  "npm pack --dry-run \u0026\u0026 npm pack --dry-run --workspaces",
                    "smoke:install":  "node ./tools/smoke-install.mjs",
                    "release:check":  "npm run validate \u0026\u0026 npm run build:all \u0026\u0026 npm run pack:all \u0026\u0026 npm run smoke:install",
                    "test:all":  "npm run test",
                    "validate:all":  "npm run validate \u0026\u0026 npm run build --workspace=charts/react \u0026\u0026 npm run build --workspace=charts/vanilla \u0026\u0026 npm run build --workspace=charts/vue \u0026\u0026 npm run build --workspace=charts/svelte \u0026\u0026 npm run build --workspace=charts/angular \u0026\u0026 npm run build --workspace=charts/lit \u0026\u0026 npm run build --workspace=charts/solid"
                },
