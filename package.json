            "require": "./dist/cjs/themes/darkTheme.js"
        },
        "./themes/engine": {
            "types": "./dist/types/themes/ThemeEngine.d.ts",
            "import": "./dist/esm/themes/ThemeEngine.js",
            "require": "./dist/cjs/themes/ThemeEngine.js"
        },
        "./plugins/export": {
            "types": "./dist/types/plugins/ExportPlugin.d.ts",
            "import": "./dist/esm/plugins/ExportPlugin.js",
            "require": "./dist/cjs/plugins/ExportPlugin.js"
        },
        "./plugins/data-labels": {
            "types": "./dist/types/plugins/DataLabelsPlugin.d.ts",
            "import": "./dist/esm/plugins/DataLabelsPlugin.js",
            "require": "./dist/cjs/plugins/DataLabelsPlugin.js"
        },
        "./plugins/statistics": {
            "types": "./dist/types/plugins/StatisticsPlugin.d.ts",
            "import": "./dist/esm/plugins/StatisticsPlugin.js",
            "require": "./dist/cjs/plugins/StatisticsPlugin.js"
        },
        "./plugins/data-table": {
            "types": "./dist/types/plugins/DataTablePlugin.d.ts",
            "import": "./dist/esm/plugins/DataTablePlugin.js",
            "require": "./dist/cjs/plugins/DataTablePlugin.js"
        },
        "./plugins/responsive": {
            "types": "./dist/types/plugins/ResponsivePlugin.d.ts",
            "import": "./dist/esm/plugins/ResponsivePlugin.js",
            "require": "./dist/cjs/plugins/ResponsivePlugin.js"
        },
        "./plugins/print": {
            "types": "./dist/types/plugins/PrintPlugin.d.ts",
            "import": "./dist/esm/plugins/PrintPlugin.js",
            "require": "./dist/cjs/plugins/PrintPlugin.js"
        },
        "./vanilla": {
            "types": "./dist/types/adapters/vanilla/index.d.ts",
            "import": "./dist/esm/adapters/vanilla/index.js",
            "require": "./dist/cjs/adapters/vanilla/index.js"
        },
        "./svelte": {
            "types": "./dist/types/adapters/svelte/index.d.ts",
            "import": "./dist/esm/adapters/svelte/index.js",
            "require": "./dist/cjs/adapters/svelte/index.js"
        },
        "./angular": {
            "types": "./dist/types/adapters/angular/index.d.ts",
            "import": "./dist/esm/adapters/angular/index.js",
            "require": "./dist/cjs/adapters/angular/index.js"
        },
        "./lit": {
            "types": "./dist/types/adapters/lit/index.d.ts",
            "import": "./dist/esm/adapters/lit/index.js",
            "require": "./dist/cjs/adapters/lit/index.js"
        },
        "./solid": {
            "types": "./dist/types/adapters/solid/index.d.ts",
            "import": "./dist/esm/adapters/solid/index.js",
            "require": "./dist/cjs/adapters/solid/index.js"
        },
        "./vue": {
            "types": "./dist/types/adapters/vue/index.d.ts",
            "import": "./dist/esm/adapters/vue/index.js",
            "require": "./dist/cjs/adapters/vue/index.js"
        },
        "./webcomponent": {
            "types": "./dist/types/adapters/webcomponent/RiskLabElement.d.ts",
            "import": "./dist/esm/adapters/webcomponent/RiskLabElement.js",
            "require": "./dist/cjs/adapters/webcomponent/RiskLabElement.js"
        },
        "./data": {
            "types": "./dist/types/data/connectors.d.ts",
            "import": "./dist/esm/data/connectors.js",
            "require": "./dist/cjs/data/connectors.js"
        },
        "./boost": {
            "types": "./dist/types/boost/index.d.ts",
            "import": "./dist/esm/boost/index.js",
            "require": "./dist/cjs/boost/index.js"
        },
        "./sdk": {
            "types": "./dist/types/sdk/index.d.ts",
            "import": "./dist/esm/sdk/index.js",
            "require": "./dist/cjs/sdk/index.js"
        },
        "./utils/datetime": {
            "types": "./dist/types/utils/datetime.d.ts",
            "import": "./dist/esm/utils/datetime.js",
            "require": "./dist/cjs/utils/datetime.js"
        },
        "./utils/math": {
            "types": "./dist/types/utils/math.d.ts",
            "import": "./dist/esm/utils/math.js",
