        },
        "./utils/format": {
            "types": "./dist/types/utils/format.d.ts",
            "import": "./dist/esm/utils/format.js",
            "require": "./dist/cjs/utils/format.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "SECURITY.md",
        "NOTICE",
        "LICENSE.txt"
    ],
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/rpwalsh"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "lint": "eslint src charts tests --ext .ts,.tsx",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean": "rimraf dist",
        "prepublishOnly": "npm run clean && npm run build",
        "typecheck": "tsc --noEmit",
        "size": "node -e \"const fs=require('fs'),p=f=>fs.statSync(f).size;console.log('ESM entry:',Math.round(p('dist/esm/index.js')/1024)+'kB');console.log('CJS entry:',Math.round(p('dist/cjs/index.js')/1024)+'kB')\"",
        "validate": "npm run clean && npm run build && npm run typecheck && npm run test && npm run size",
        "build:charts-react": "npm run build --workspace=charts/react",
        "build:charts-vanilla": "npm run build --workspace=charts/vanilla",
        "build:charts-vue": "npm run build --workspace=charts/vue",
        "build:charts-svelte": "npm run build --workspace=charts/svelte",
        "build:charts-angular": "npm run build --workspace=charts/angular",
        "build:charts-lit": "npm run build --workspace=charts/lit",
        "build:charts-solid": "npm run build --workspace=charts/solid",
        "build:all": "npm run build && npm run build --workspace=charts/react && npm run build --workspace=charts/vanilla && npm run build --workspace=charts/vue && npm run build --workspace=charts/svelte && npm run build --workspace=charts/angular && npm run build --workspace=charts/lit && npm run build --workspace=charts/solid",
        "pack:all": "npm pack --dry-run && npm pack --dry-run --workspaces",
        "smoke:install": "node ./tools/smoke-install.mjs",
        "release:check": "npm run validate && npm run build:all && npm run pack:all && npm run smoke:install",
        "test:all": "npm run test",
        "validate:all": "npm run validate && npm run build --workspace=charts/react && npm run build --workspace=charts/vanilla && npm run build --workspace=charts/vue && npm run build --workspace=charts/svelte && npm run build --workspace=charts/angular && npm run build --workspace=charts/lit && npm run build --workspace=charts/solid"
    },
    "keywords": [
        "charts",
        "graphs",
        "visualization",
        "react",
        "svg",
        "canvas",
        "sankey",
        "line-chart",
        "bar-chart",
        "stacked-chart",
        "multi-axis",
        "timeline",
        "animation",
        "open-source",
        "data-visualization",
        "dataviz",
        "analytical-software",
        "dashboard",
        "workbench",
        "mui",
        "material-ui",
        "stylex",
        "xstyle",
        "css-in-js",
        "smith-chart",
        "polar-chart",
        "contour",
        "oscilloscope",
        "spectrum-analyzer",
        "engineering",
        "aviation",
        "color-palettes",
        "dark-mode",
        "risklab"
    ],
    "author": "RiskLab Contributors",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/rpwalsh/risklab-charts",
        "directory": "."
    },
    "homepage": "https://rpwalsh.github.io/",
    "bugs": {
        "url": "https://github.com/rpwalsh/risklab-charts/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@angular/core": ">=17.0.0",
        "lit": ">=3.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "solid-js": ">=1.8.0",
        "svelte": ">=4.0.0",
        "vue": ">=3.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "solid-js": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "svelte": {
            "optional": true
        },
        "@angular/core": {
            "optional": true
        },
        "lit": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.5.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitest/coverage-v8": "^3.0.0",
        "eslint": "^10.1.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "jsdom": "^29.0.0",
        "prettier": "^3.4.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "rimraf": "^6.0.0",
        "typedoc": "^0.28.18",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.58.0",
        "vite": "^6.4.1",
        "vitest": "^3.0.0"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
